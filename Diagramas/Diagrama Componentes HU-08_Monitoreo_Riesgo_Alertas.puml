@startuml HU-08_Monitoreo_Riesgo_Alertas
title HU-08 — Monitoreo de Riesgo y Alertas\nDeFi360 · Sprint 1 · Release 01

skinparam componentStyle rectangle
skinparam backgroundColor #FAFAFA
skinparam component {
  BackgroundColor #F5EEF8
  BorderColor #6C3483
  FontSize 12
}
skinparam interface {
  BackgroundColor #FDEBD0
  BorderColor #E67E22
}
skinparam node {
  BackgroundColor #F2F3F4
  BorderColor #717D7E
}
skinparam database {
  BackgroundColor #D5F5E3
  BorderColor #1E8449
}
skinparam arrow {
  Color #2C3E50
  FontSize 10
}

' ─── FRONTEND ──────────────────────────────────────────────────
node "Frontend (React)" {
  [RiskDashboard.jsx] as RiskDash
  [AlertBanner.jsx] as AlertBanner
  
}

' ─── NÚCLEO: MONITOR DE RIESGO ─────────────────────────────────
node "Backend — Core" {
  [MonitorRiesgo] as Monitor
  
}

' ─── PATRÓN STRATEGY ───────────────────────────────────────────
interface "IRiskStrategy" as IRiskStrat
note bottom of IRiskStrat
  <<interface>> — Strategy
  + evaluate(prestamo, precioActual): RiskLevel
end note

node "Backend — Strategies" {
  [LTVThresholdStrategy] as LTVStrat
  [MockRiskStrategy] as MockStrat
  
}

' ─── PATRÓN OBSERVER ───────────────────────────────────────────
interface "RiskObserver" as IRiskObs


node "Backend — Observers" {
  [NotificationObserver] as NotifObs
  [LogObserver] as LogObs
  [EmailObserver] as EmailObs
  
  
}

' ─── MODELO ────────────────────────────────────────────────────
node "Backend — Domain Model" {
  [RiskEvent] as RiskEvt
  [RiskLevel\n«enum»] as RiskLvl
  
}

' ─── FUENTE DE DATOS PRECIO ────────────────────────────────────
node "Backend — Adapters" {
  [SimulatedOracleAdapter] as SimOracle
}
interface "IPriceOracle" as IOracle

' ─── BASE DE DATOS ─────────────────────────────────────────────
database "PostgreSQL" as PG {
  [tabla: PRESTAMO\n(índice compuesto)] as TblPrestamo
  [tabla: ALERTA] as TblAlerta
}

' ─── PRUEBAS ───────────────────────────────────────────────────
node "Tests (Jest / JUnit)" {
  [RiskMonitor.integration.test] as RiskTest
  
}

' ─── RELACIONES ────────────────────────────────────────────────
RiskDash      --> AlertBanner       : muestra alertas
RiskDash      <.. NotifObs          : notifica evento UI

Monitor       ..> IRiskStrat        : «depends on»\n(Strategy inyectada)
LTVStrat      ..|> IRiskStrat       : «implements»
MockStrat     ..|> IRiskStrat       : «implements»

Monitor       --> IRiskObs          : notifica a observers
NotifObs      ..|> IRiskObs         : «implements»
LogObs        ..|> IRiskObs         : «implements»
EmailObs      ..|> IRiskObs         : «implements»

Monitor       ..> IOracle           : «depends on»
SimOracle     ..|> IOracle          : «implements»

Monitor       --> RiskEvt           : crea y emite
IRiskStrat    --> RiskLvl           : retorna nivel

Monitor       --> TblPrestamo       : consulta préstamos activos
NotifObs      --> TblAlerta         : INSERT alerta
LogObs        --> TblAlerta         : INSERT log

RiskTest      --> Monitor           : prueba integración
RiskTest      ..> MockStrat         : inyecta mock strategy

@enduml