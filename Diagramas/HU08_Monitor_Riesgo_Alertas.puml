@startuml HU08_Monitor_Riesgo_Alertas
title HU-08 — Monitoreo de Riesgo y Alertas\nObserver + Strategy (Sprint 1 · DeFi360)

skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam sequenceParticipantBorderColor #2E75B6
skinparam sequenceParticipantBackgroundColor #EBF3FB
skinparam noteBorderColor #F0A500
skinparam noteBackgroundColor #FFF8E1

participant "RiskMonitoringService"        as RMS
participant "Scheduler\n(setInterval en startMonitoring)" as SCHED
participant "MonitorRiesgo\n<<Subject>>"   as MR
participant "<<interface>>\nIRiskStrategy" as IRS
participant "LTVRiskStrategy\n<<Strategy>>" as LTS
participant "priceOracle (Singleton)"      as ORA
participant "<<interface>>\nIRiskObserver" as IRO
participant "NotificationObserver"         as NO
participant "LogObserver"                  as LO

autonumber

note over MR, IRS
  RiskMonitoringService construye MonitorRiesgo(LTVRiskStrategy) y suscribe
  NotificationObserver + LogObserver. MonitorRiesgo notifica a los observers
  (Observer/OCP) y delega la evaluación a IRiskStrategy (Strategy/DIP).
end note

RMS -> MR : subscribe(NotificationObserver)
RMS -> MR : subscribe(LogObserver)

MR -> SCHED : startMonitoring(loan, priceOracle, intervalMs)\n→ setInterval(checkRisk)

loop cada intervalMs (checkRisk)
    SCHED -> ORA : getPrice(loan.collateralType)
    ORA --> SCHED : precio actual (caché TTL)

    SCHED -> MR : evaluateLoanRisk(loan, currentCollateralPrice)
    activate MR

    MR -> IRS : evaluate(loan.amount, collateralValue)
    IRS -> LTS : evaluate(...)
    activate LTS
    LTS --> MR : { ratio, riskLevel, isHealthy, message }
    deactivate LTS

    alt ltv >= 95% (CRITICAL) o ltv >= 90% (HIGH)
        MR -> IRO : _notifyObservers(alertEvent)
        IRO -> NO : onRiskEvent(event)
        activate NO
        NO -> NO : crear notificación + sentNotifications.push
        NO --> IRO : OK (envío real o demo)
        deactivate NO
        IRO -> LO : onRiskEvent(event)
        activate LO
        LO -> LO : eventLog.push (auditoría en memoria)
        LO --> IRO : OK
        deactivate LO
    else LTV bajó ≥ 5% respecto al estado previo
        MR -> IRO : _notifyObservers(RISK_IMPROVED)
    end

    MR --> SCHED : event
    deactivate MR
end

note over RMS, LO
  QA: src/test/observerPattern.test.js, LTVRiskStrategy.test.js,
  riskIntegration.test.js. Alertas/logs se almacenan en memoria
  (no hay tabla de alertas en Release 01).
end note

@enduml
