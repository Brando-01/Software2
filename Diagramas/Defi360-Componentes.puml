@startuml
' =====================================
' CONFIGURACIÓN UML
' =====================================

skinparam componentStyle uml2
skinparam linetype ortho
skinparam shadowing false

skinparam component {
    BackgroundColor #F8FAFB
    BorderColor #2C3E50
    FontColor #1B2631
}

skinparam interface {
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
}

skinparam database {
    BackgroundColor #FFF8E7
    BorderColor #B9770E
}

skinparam cloud {
    BackgroundColor #EBF5FB
    BorderColor #3498DB
}

skinparam node {
    BackgroundColor #F4F6F7
    BorderColor #5D6D7E
}

title DeFi360 — Diagrama de Componentes (arquitectura real de 3 capas · Release 01)

' =====================================
' ACTOR
' =====================================

actor Usuario

' =====================================
' CAPA CLIENTE
' =====================================

node "Cliente Web" {
    component "Frontend Web (React SPA)" as Frontend <<React>>
    note bottom of Frontend
      Sin lógica de negocio:
      consume la API REST.
      Precios via PricesContext
      (GET /marketplace/prices).
      localStorage solo guarda JWT.
    end note
}

interface "API REST /api (HTTP+JSON)" as REST

' =====================================
' CAPA BACKEND (Express)
' =====================================

node "Servidor Backend (Express · src/app.js)" {

    package "Controllers (src/controllers)" {
        component "authController\n/api/auth" as Auth <<controller>>
        component "marketplaceController\n/api/marketplace" as Market <<controller>>
        component "loanController\n/api/loans" as Loan <<controller>>
        component "supportController\n/api/support" as Support <<controller>>
    }

    package "Middleware" {
        component "authMiddleware (protect, JWT)" as Mw <<middleware>>
    }

    package "Services / Patrones (src/services)" {
        component "AuthService (JWT + bcrypt)" as AuthSvc <<service>>
        component "CollateralService\n(DIP sobre IPriceOracle)" as Collateral <<service>>
        component "LTVCalculatorService" as LTV <<calculation>>
        component "StandardPaymentProcessor\n(IPaymentProcessor)" as Pay <<service>>
        component "priceOracle (Singleton)\nCachedPriceOracle(SimulatedOracleAdapter)" as Oracle <<singleton>>
        component "MonitorRiesgo + RiskMonitoringService\n(scheduler setInterval)" as Risk <<monitor>>
        component "LogObserver / NotificationObserver\n(Observer)" as Observers <<observer>>
        component "LTVRiskStrategy (Strategy)" as Strategy <<strategy>>
    }

    package "Factories (src/factories)" {
        component "LoanFactory\n(Fixed / Variable)" as Factory <<factory>>
    }

    note bottom of Oracle
      TÁCTICA DE PERFORMANCE: caché con TTL.
      CachedPriceOracle (Decorator) envuelve a
      SimulatedOracleAdapter. HIT/MISS + stats.
    end note
}

' =====================================
' EXTERNOS / SIMULADOS
' =====================================

component "SimulatedOracleAdapter\n(fuente de precios SIMULADA)" as SimOracle <<simulado>>
note bottom of SimOracle
  Decisión de alcance Release 01:
  precios simulados deterministas.
  NO es un oráculo blockchain real.
end note

collections "MockWalletConnector\n(connect-wallet simulado)" as MockWallet <<simulado>>

database "PostgreSQL (DeFi360)\nvía Sequelize" as DB <<PostgreSQL>>

component "DatabaseConnection (Singleton)\nsrc/config/database.js" as DBConn <<singleton>>

' =====================================
' FUERA DE ALCANCE (no implementado)
' =====================================

package "Fuera de alcance Release 01 / extensión futura" #EEEEEE {
    component "Blockchain / Smart Contracts" as Smart <<futuro>>
    component "Oráculo on-chain (Chainlink)" as ChainOracle <<futuro>>
}

' =====================================
' RELACIONES
' =====================================

Usuario --> Frontend
Frontend --> REST
REST ..> Auth
REST ..> Market
REST ..> Loan
REST ..> Support

' Middleware protege rutas
Loan ..> Mw : protect (JWT)
Market ..> Mw : protect (JWT)
Support ..> Mw : protect (JWT)
Auth ..> Mw : protect (profile)

' Controladores -> servicios
Auth ..> AuthSvc : register/login/issueToken
Auth ..> MockWallet : connect-wallet (DIP IWalletConnector)

Market ..> Oracle : getPrice / getPrices (enriquecimiento)
Loan ..> Collateral : calculateValue (requestLoan/calculateLTV)
Loan ..> LTV : calculateLTV
Loan ..> Factory : matchLoan (createFromOffer)
Loan ..> Pay : payLoan (processPayment)
Loan ..> Oracle : simulate (getPrice)

Collateral ..> Oracle : DIP (IPriceOracle)
Oracle --> SimOracle : delega en MISS / TTL vencido (Decorator)

Risk ..> Strategy : evaluate (Strategy inyectada)
Risk ..> Observers : onRiskEvent (Observer)
Risk ..> Oracle : getPrice (monitoreo periódico)

' Persistencia
Auth --> DBConn
Loan --> DBConn
Market --> DBConn
Support --> DBConn
Pay --> DBConn
DBConn --> DB : Sequelize (instancia única)

' Extensión futura (NO implementada)
ChainOracle ..> SimOracle : sustituiría (mismo IPriceOracle)
Smart ..> MockWallet : sustituiría (custodia real)

@enduml
