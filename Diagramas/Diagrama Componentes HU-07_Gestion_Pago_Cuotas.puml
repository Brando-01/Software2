@startuml HU-07_Gestion_Pago_Cuotas
title HU-07 — Gestión y Pago de Cuotas (Componentes)\nDeFi360 · Sprint 1 · Release 01

skinparam componentStyle rectangle
skinparam backgroundColor #FAFAFA
skinparam component {
  BackgroundColor #EAF2FF
  BorderColor #1F618D
  FontSize 12
}
skinparam interface {
  BackgroundColor #FDEBD0
  BorderColor #E67E22
}
skinparam node {
  BackgroundColor #F2F3F4
  BorderColor #717D7E
}
skinparam database {
  BackgroundColor #D5F5E3
  BorderColor #1E8449
}
skinparam arrow {
  Color #2C3E50
  FontSize 10
}

' ─── FRONTEND ───────────────────────────────────────────────────
node "Frontend (React SPA)" {
  [main.jsx — Pago / LTV] as PayForm
}

' ─── CONTROLADOR ────────────────────────────────────────────────
node "Backend — Controllers" {
  [loanController (payLoan)] as LoanCtrl
}

' ─── INTERFAZ DIP ───────────────────────────────────────────────
interface "IPaymentProcessor" as IPayProc

' ─── IMPLEMENTACIÓN ─────────────────────────────────────────────
node "Backend — Services" {
  [StandardPaymentProcessor] as StdPayProc
}

' ─── MODELOS ────────────────────────────────────────────────────
node "Backend — Domain Model" {
  [Loan] as LoanModel
  [Wallet] as WalletModel
  [Offer] as OfferModel
}

' ─── INFRAESTRUCTURA ────────────────────────────────────────────
node "Backend — Infrastructure" {
  [DatabaseConnection «Singleton»] as DBConn
}

database "PostgreSQL" as PG {
  [tabla: loans\n+ índice (borrower_id, status, end_date)] as TblLoans
  [tabla: wallets] as TblWallets
}

' ─── PRUEBAS ────────────────────────────────────────────────────
node "Tests (Jest)" {
  [StandardPaymentProcessor.test.js] as PayTest
  [loanController.test.js] as LoanTest
}

' ─── RELACIONES ─────────────────────────────────────────────────
PayForm    --> LoanCtrl    : POST /api/loans/{id}/pay
LoanCtrl   ..> IPayProc    : «depends on» (inyección por parámetro)
StdPayProc ..|> IPayProc   : «implements»
StdPayProc --> LoanModel   : findByPk / update (remainingBalance, ltv, status)
StdPayProc --> WalletModel : update saldos (borrower / lender)
StdPayProc ..> OfferModel  : collateralAmount (recalculateLTV)
LoanModel  --> DBConn
WalletModel --> DBConn
DBConn     --> PG          : Sequelize (instancia única)
LoanModel  ..> TblLoans    : UPDATE
WalletModel ..> TblWallets : UPDATE
PayTest    ..> IPayProc    : prueba directa del processor
LoanTest   --> LoanCtrl    : prueba payLoan (mock processor)

@enduml
