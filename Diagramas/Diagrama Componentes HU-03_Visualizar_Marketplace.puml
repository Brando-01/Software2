@startuml HU-03_Visualizar_Marketplace
title HU-03 — Visualizar Marketplace\nDeFi360 · Sprint 1 · Release 01

skinparam componentStyle rectangle
skinparam backgroundColor #FAFAFA
skinparam component {
  BackgroundColor #EBF5FB
  BorderColor #1A5276
  FontSize 12
}
skinparam interface {
  BackgroundColor #FDEBD0
  BorderColor #E67E22
}
skinparam node {
  BackgroundColor #F2F3F4
  BorderColor #717D7E
}
skinparam database {
  BackgroundColor #D5F5E3
  BorderColor #1E8449
}
skinparam arrow {
  Color #2C3E50
  FontSize 10
}

' ─── FRONTEND ──────────────────────────────────────────────────
node "Frontend (React)" {
  [MarketplacePage.jsx] as MktPage
  [OfertaCard.jsx] as OfertaCard
  [FilterBar.jsx] as FilterBar
  
}

' ─── INTERFAZ ORACLE (DIP + OCP) ───────────────────────────────
interface "IPriceOracle" as IOracle


' ─── ADAPTER ───────────────────────────────────────────────────
node "Backend — Adapters" {
  [SimulatedOracleAdapter] as SimOracle
  [ChainlinkOracleAdapter] as ChainOracle
  
}

' ─── SERVICIO DE CONSULTA ──────────────────────────────────────
node "Backend — Services" {
  [OfertaQueryService] as OQuery
  
}

' ─── CONTROLADOR ───────────────────────────────────────────────
node "Backend — Controllers" {
  [MarketplaceController] as MktCtrl
  
}

' ─── ENTIDAD / MODELO ──────────────────────────────────────────
node "Backend — Domain Model" {
  [OfertaLending] as OfertaModel
  
}

' ─── BASE DE DATOS ─────────────────────────────────────────────
database "PostgreSQL" as PG {
  [tabla: OFERTA_LENDING] as TblOferta
}

' ─── FUENTE EXTERNA ────────────────────────────────────────────
[OracleService\n(externo)] as ExtOracle

' ─── RELACIONES ────────────────────────────────────────────────
MktPage       --> FilterBar         : usa
MktPage       --> OfertaCard        : renderiza lista

MktPage       ..> IOracle           : «depends on»\n(props inyectadas)
SimOracle     ..|> IOracle          : «implements»
ChainOracle   ..|> IOracle          : «implements»
SimOracle     --> ExtOracle         : invoca fuente externa
ChainOracle   --> ExtOracle         : invoca fuente externa

MktPage       --> MktCtrl           : GET /marketplace/ofertas

MktCtrl       ..> IOracle           : «depends on»
MktCtrl       --> OQuery            : delega filtrado
OQuery        --> OfertaModel       : opera sobre
OQuery        --> TblOferta         : SELECT con filtros
OfertaModel   ..> TblOferta         : mapeado

@enduml