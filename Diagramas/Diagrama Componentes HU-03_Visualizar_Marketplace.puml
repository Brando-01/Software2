@startuml HU-03_Visualizar_Marketplace
title HU-03 — Visualizar Marketplace (Componentes)\nDeFi360 · Sprint 1 · Release 01

skinparam componentStyle rectangle
skinparam backgroundColor #FAFAFA
skinparam component {
  BackgroundColor #EBF5FB
  BorderColor #1A5276
  FontSize 12
}
skinparam interface {
  BackgroundColor #FDEBD0
  BorderColor #E67E22
}
skinparam node {
  BackgroundColor #F2F3F4
  BorderColor #717D7E
}
skinparam database {
  BackgroundColor #D5F5E3
  BorderColor #1E8449
}
skinparam arrow {
  Color #2C3E50
  FontSize 10
}

' ─── FRONTEND ───────────────────────────────────────────────────
node "Frontend (React SPA)" {
  [main.jsx — Marketplace] as MktPage
  [PricesContext] as PricesCtx
}

' ─── CONTROLADOR ────────────────────────────────────────────────
node "Backend — Controllers" {
  [marketplaceController\n(getOffers / getPrices / getCacheStats)] as MktCtrl
}

' ─── ABSTRACCIÓN ORACLE (DIP) ───────────────────────────────────
interface "IPriceOracle" as IOracle

' ─── DECORATOR: CACHÉ TTL (táctica de performance) ──────────────
node "Backend — Performance" {
  [priceOracle «Singleton»\nCachedPriceOracle «Decorator TTL»] as CacheOracle
}

' ─── ADAPTER (fuente simulada) ──────────────────────────────────
node "Backend — Adapters" {
  [SimulatedOracleAdapter] as SimOracle
}

' ─── MODELO ─────────────────────────────────────────────────────
node "Backend — Domain Model" {
  [Offer (Sequelize)] as OfferModel
}

database "PostgreSQL" as PG {
  [tabla: offers] as TblOffers
}

' ─── RELACIONES ─────────────────────────────────────────────────
MktPage     --> PricesCtx   : usa precios cacheados
PricesCtx   --> MktCtrl     : GET /api/marketplace/prices
MktPage     --> MktCtrl     : GET /api/marketplace/offers

MktCtrl     ..> IOracle     : «depends on» (DIP)
CacheOracle ..|> IOracle    : «implements» (Decorator transparente)
SimOracle   ..|> IOracle    : «implements» (Adapter)
CacheOracle --> SimOracle   : delega en MISS / TTL vencido

MktCtrl     --> OfferModel  : Offer.findAll(where, include User)
OfferModel  ..> TblOffers   : SELECT con filtros

note bottom of SimOracle
  Decisión de alcance: fuente de precios SIMULADA y determinista
  (volatility=0). Un ChainlinkOracleAdapter real implementaría
  la misma IPriceOracle sin tocar el controlador (OCP) — futuro.
end note

@enduml
