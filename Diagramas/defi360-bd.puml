@startuml DeFi360 - Diagrama de Base de Datos
left to right direction
skinparam linetype ortho
skinparam entity {
  BackgroundColor #F0F7FF
  BorderColor #2C3E50
  HeaderBackgroundColor #1A3A5C
  HeaderFontColor #FFFFFF
  FontSize 11
}
skinparam arrow {
  Color #2C3E50
  FontSize 10
}

title DeFi360 — Diagrama de Base de Datos Completo

' ─────────────────────────────────────────
'  USUARIOS Y SEGURIDAD
' ─────────────────────────────────────────
entity USUARIO {
  *id_usuario       : INT (PK, AUTO_INCREMENT)
  --
  wallet_address    : VARCHAR(42) UNIQUE NOT NULL
  nombre            : VARCHAR(100) NOT NULL
  email             : VARCHAR(150) UNIQUE
  tipo_usuario      : ENUM('INVERSIONISTA','PRESTATARIO','ADMINISTRADOR')
  activo            : BOOLEAN DEFAULT TRUE
  fecha_registro    : DATETIME DEFAULT NOW()
  ultima_sesion     : DATETIME
}

entity TICKET_SOPORTE {
  *id_ticket        : INT (PK, AUTO_INCREMENT)
  --
  #id_usuario_creador : INT (FK → USUARIO)
  #id_admin_asignado  : INT (FK → USUARIO) NULL
  asunto            : VARCHAR(200) NOT NULL
  descripcion       : TEXT NOT NULL
  prioridad         : TINYINT DEFAULT 2
  estado            : ENUM('ABIERTO','EN_PROCESO','CERRADO') DEFAULT 'ABIERTO'
  resolucion        : TEXT NULL
  fecha_creacion    : DATETIME DEFAULT NOW()
  fecha_cierre      : DATETIME NULL
}

entity LOG_EVENTO {
  *id_log           : INT (PK, AUTO_INCREMENT)
  --
  #id_usuario       : INT (FK → USUARIO) NULL
  tipo              : VARCHAR(50) NOT NULL
  descripcion       : TEXT NOT NULL
  ip_origen         : VARCHAR(45)
  fecha             : DATETIME DEFAULT NOW()
}

' ─────────────────────────────────────────
'  WALLET Y ACTIVOS
' ─────────────────────────────────────────
entity ACTIVO {
  *id_activo        : INT (PK, AUTO_INCREMENT)
  --
  simbolo           : VARCHAR(10) UNIQUE NOT NULL
  nombre            : VARCHAR(100) NOT NULL
  tipo              : ENUM('CRIPTOMONEDA','STABLECOIN','TOKEN')
  decimales         : TINYINT DEFAULT 18
  activo            : BOOLEAN DEFAULT TRUE
}

entity WALLET {
  *id_wallet        : INT (PK, AUTO_INCREMENT)
  --
  #id_usuario       : INT (FK → USUARIO, UNIQUE)
  wallet_address    : VARCHAR(42) NOT NULL
  saldo_total       : DECIMAL(28,8) DEFAULT 0
  saldo_disponible  : DECIMAL(28,8) DEFAULT 0
  saldo_bloqueado   : DECIMAL(28,8) DEFAULT 0
  fecha_creacion    : DATETIME DEFAULT NOW()
  ultima_actualizacion : DATETIME
}

entity POSICION_WALLET {
  *id_posicion      : INT (PK, AUTO_INCREMENT)
  --
  #id_wallet        : INT (FK → WALLET)
  #id_activo        : INT (FK → ACTIVO)
  cantidad          : DECIMAL(28,8) DEFAULT 0
  cantidad_bloqueada : DECIMAL(28,8) DEFAULT 0
  bloqueado_colateral : BOOLEAN DEFAULT FALSE
  ultima_actualizacion : DATETIME
  --
  UNIQUE (id_wallet, id_activo)
}

entity TRANSACCION {
  *id_transaccion   : INT (PK, AUTO_INCREMENT)
  --
  #id_wallet        : INT (FK → WALLET)
  #id_activo        : INT (FK → ACTIVO)
  tipo              : ENUM('DEPOSITO','RETIRO','BLOQUEO','LIBERACION','PAGO','LIQUIDACION')
  monto             : DECIMAL(28,8) NOT NULL
  referencia_id     : INT NULL
  referencia_tipo   : VARCHAR(50) NULL
  fecha             : DATETIME DEFAULT NOW()
  descripcion       : VARCHAR(255)
}

' ─────────────────────────────────────────
'  ORÁCULO DE PRECIOS
' ─────────────────────────────────────────
entity ORACULO_PRECIO_LOG {
  *id_registro      : INT (PK, AUTO_INCREMENT)
  --
  #id_activo        : INT (FK → ACTIVO)
  precio_usd        : DECIMAL(28,8) NOT NULL
  variacion_24h     : DECIMAL(6,2)
  fuente            : VARCHAR(100)
  fecha             : DATETIME DEFAULT NOW()
  --
  INDEX (id_activo, fecha)
}

' ─────────────────────────────────────────
'  LENDING / BORROWING
' ─────────────────────────────────────────
entity OFERTA_LENDING {
  *id_oferta        : INT (PK, AUTO_INCREMENT)
  --
  #id_usuario_inversionista : INT (FK → USUARIO)
  #id_activo        : INT (FK → ACTIVO)
  monto             : DECIMAL(28,8) NOT NULL
  tasa_interes_anual : DECIMAL(6,4) NOT NULL
  plazo_dias        : INT NOT NULL
  monto_min_prestamo : DECIMAL(28,8) DEFAULT 0
  estado            : ENUM('PUBLICADA','EMPAREJADA','CANCELADA','EXPIRADA') DEFAULT 'PUBLICADA'
  fecha_publicacion : DATETIME DEFAULT NOW()
  fecha_expiracion  : DATETIME NOT NULL
}

entity SOLICITUD_PRESTAMO {
  *id_solicitud     : INT (PK, AUTO_INCREMENT)
  --
  #id_usuario_prestatario : INT (FK → USUARIO)
  #id_activo_colateral    : INT (FK → ACTIVO)
  monto_solicitado  : DECIMAL(28,8) NOT NULL
  monto_colateral   : DECIMAL(28,8) NOT NULL
  ltv_objetivo      : DECIMAL(6,4) NOT NULL
  plazo_dias        : INT NOT NULL
  estado            : ENUM('PENDIENTE','APROBADA','RECHAZADA','CANCELADA') DEFAULT 'PENDIENTE'
  motivo_rechazo    : VARCHAR(255) NULL
  fecha_creacion    : DATETIME DEFAULT NOW()
}

entity PRESTAMO {
  *id_prestamo      : INT (PK, AUTO_INCREMENT)
  --
  #id_usuario_prestatario : INT (FK → USUARIO)
  #id_oferta        : INT (FK → OFERTA_LENDING) NULL
  #id_solicitud     : INT (FK → SOLICITUD_PRESTAMO) NULL
  monto             : DECIMAL(28,8) NOT NULL
  tasa_interes      : DECIMAL(6,4) NOT NULL
  ltv_inicial       : DECIMAL(6,4) NOT NULL
  ltv_actual        : DECIMAL(6,4) NOT NULL
  saldo_pendiente   : DECIMAL(28,8) NOT NULL
  cuota_mensual     : DECIMAL(28,8) NOT NULL
  mora_acumulada    : DECIMAL(28,8) DEFAULT 0
  estado            : ENUM('ACTIVO','EN_MORA','LIQUIDADO','COMPLETADO') DEFAULT 'ACTIVO'
  fecha_inicio      : DATETIME DEFAULT NOW()
  fecha_vencimiento : DATETIME NOT NULL
  fecha_cierre      : DATETIME NULL
}

entity COLATERAL {
  *id_colateral     : INT (PK, AUTO_INCREMENT)
  --
  #id_prestamo      : INT (FK → PRESTAMO)
  #id_activo        : INT (FK → ACTIVO)
  monto_bloqueado   : DECIMAL(28,8) NOT NULL
  valor_actual_usd  : DECIMAL(28,8) NOT NULL
  ltv_actual        : DECIMAL(6,4) NOT NULL
  umbral_alerta     : DECIMAL(6,4) DEFAULT 0.75
  umbral_liquidacion : DECIMAL(6,4) DEFAULT 0.90
  fecha_bloqueo     : DATETIME DEFAULT NOW()
  ultima_valoracion : DATETIME
}

' ─────────────────────────────────────────
'  RIESGO Y ALERTAS
' ─────────────────────────────────────────
entity ALERTA_RIESGO {
  *id_alerta        : INT (PK, AUTO_INCREMENT)
  --
  #id_prestamo      : INT (FK → PRESTAMO)
  #id_usuario_destino : INT (FK → USUARIO)
  tipo              : ENUM('RIESGO_MODERADO','RIESGO_ALTO','LIQUIDACION_INMINENTE','LIQUIDACION_EJECUTADA')
  mensaje           : TEXT NOT NULL
  ltv_al_momento    : DECIMAL(6,4)
  estado            : ENUM('PENDIENTE','ATENDIDA','IGNORADA') DEFAULT 'PENDIENTE'
  fecha             : DATETIME DEFAULT NOW()
  fecha_atencion    : DATETIME NULL
}

' ─────────────────────────────────────────
'  ZONA EDUCATIVA
' ─────────────────────────────────────────
entity RECURSO_EDUCATIVO {
  *id_recurso       : INT (PK, AUTO_INCREMENT)
  --
  #id_admin_creador : INT (FK → USUARIO)
  titulo            : VARCHAR(200) NOT NULL
  tipo_recurso      : ENUM('GUIA','VIDEO','ARTICULO','GLOSARIO','INFOGRAFIA')
  contenido         : TEXT
  url_contenido     : VARCHAR(500)
  nivel             : ENUM('BASICO','INTERMEDIO','AVANZADO')
  etiquetas         : VARCHAR(500)
  veces_visto       : INT DEFAULT 0
  activo            : BOOLEAN DEFAULT TRUE
  fecha_creacion    : DATETIME DEFAULT NOW()
}

entity TERMINO_GLOSARIO {
  *id_termino       : INT (PK, AUTO_INCREMENT)
  --
  termino           : VARCHAR(100) UNIQUE NOT NULL
  definicion        : TEXT NOT NULL
  ejemplos          : TEXT NULL
  terminos_relacionados : VARCHAR(500) NULL
  fecha_creacion    : DATETIME DEFAULT NOW()
}

entity ACTIVIDAD_EDUCATIVA {
  *id_actividad     : INT (PK, AUTO_INCREMENT)
  --
  #id_usuario       : INT (FK → USUARIO)
  #id_recurso       : INT (FK → RECURSO_EDUCATIVO)
  tipo_actividad    : ENUM('VISTA','COMPLETADO','SIMULACION')
  duracion_segundos : INT NULL
  fecha             : DATETIME DEFAULT NOW()
}

entity SIMULACION_DEFI {
  *id_simulacion    : INT (PK, AUTO_INCREMENT)
  --
  #id_usuario       : INT (FK → USUARIO)
  #id_activo        : INT (FK → ACTIVO) NULL
  tipo              : ENUM('LENDING','BORROWING')
  monto_inicial     : DECIMAL(28,8) NOT NULL
  tasa_anual        : DECIMAL(6,4) NOT NULL
  plazo_dias        : INT NOT NULL
  ltv_simulado      : DECIMAL(6,4) NULL
  rendimiento_estimado : DECIMAL(28,8) NOT NULL
  resultado_detallado  : JSON NULL
  fecha             : DATETIME DEFAULT NOW()
}

' ─────────────────────────────────────────
'  RELACIONES
' ─────────────────────────────────────────

' Usuarios
USUARIO ||--|| WALLET                : "posee"
USUARIO ||--o{ TICKET_SOPORTE        : "crea"
USUARIO ||--o{ TICKET_SOPORTE        : "admin asignado"
USUARIO ||--o{ LOG_EVENTO            : "genera"

' Wallet
WALLET ||--o{ POSICION_WALLET        : "contiene"
WALLET ||--o{ TRANSACCION            : "registra"
ACTIVO ||--o{ POSICION_WALLET        : "en"
ACTIVO ||--o{ TRANSACCION            : "involucra"

' Oráculo
ACTIVO ||--o{ ORACULO_PRECIO_LOG     : "historial precio"

' Lending/Borrowing
USUARIO ||--o{ OFERTA_LENDING        : "publica"
ACTIVO  ||--o{ OFERTA_LENDING        : "activo ofertado"
USUARIO ||--o{ SOLICITUD_PRESTAMO    : "solicita"
ACTIVO  ||--o{ SOLICITUD_PRESTAMO    : "colateral"
OFERTA_LENDING   ||--o{ PRESTAMO     : "origina"
SOLICITUD_PRESTAMO ||--o{ PRESTAMO   : "se convierte en"
USUARIO ||--o{ PRESTAMO              : "prestatario"
PRESTAMO ||--o{ COLATERAL            : "garantizado con"
ACTIVO   ||--o{ COLATERAL            : "activo bloqueado"

' Riesgo
PRESTAMO ||--o{ ALERTA_RIESGO        : "genera"
USUARIO  ||--o{ ALERTA_RIESGO        : "recibe"

' Educativo
USUARIO ||--o{ SIMULACION_DEFI       : "ejecuta"
ACTIVO  ||--o{ SIMULACION_DEFI       : "simula"
USUARIO ||--o{ ACTIVIDAD_EDUCATIVA   : "registra"
RECURSO_EDUCATIVO ||--o{ ACTIVIDAD_EDUCATIVA : "consultado en"
USUARIO ||--o{ RECURSO_EDUCATIVO     : "crea (admin)"

@enduml
