@startuml DeFi360 - Diagrama de Clases
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam packageFontSize 13
skinparam linetype ortho
skinparam class {
  BackgroundColor #F8FAFB
  BorderColor #2C3E50
  HeaderBackgroundColor #2C3E50
  HeaderFontColor #FFFFFF
  ArrowColor #2C3E50
}
skinparam package {
  BackgroundColor #EAF2FF
  BorderColor #2980B9
  FontColor #1A252F
}

title DeFi360 — Diagrama de Clases de Diseño (reconciliado con el código real)

' ─────────────────────────────────────────
'  ENUMERACIONES (valores reales de los modelos Sequelize / ENUM Postgres)
' ─────────────────────────────────────────
enum UserRole {
  user
  admin
}

enum OfferType {
  lend
  borrow
}

enum OfferStatus {
  active
  matched
  cancelled
  completed
}

enum LoanRateType {
  fixed
  variable
}

enum LoanStatus {
  active
  paid
  defaulted
  liquidated
}

enum TicketPriority {
  low
  medium
  high
  critical
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

' ─────────────────────────────────────────
'  PAQUETE: Modelos de Dominio (src/models — Sequelize)
' ─────────────────────────────────────────
package "Modelos de Dominio (src/models)" {

  class User {
    +id: int
    +walletAddress: string
    +email: string
    +passwordHash: string
    +name: string
    +role: UserRole
    +isActive: boolean
    +lastLogin: datetime
    +compareWallet(walletAddress): boolean
  }

  class Wallet {
    +id: int
    +userId: int
    +totalBalance: decimal
    +availableBalance: decimal
    +blockedBalance: decimal
    +totalEarned: decimal
  }

  class Offer {
    +id: int
    +userId: int
    +type: OfferType
    +amount: decimal
    +apy: decimal
    +duration: int
    +collateralType: string
    +collateralAmount: decimal
    +status: OfferStatus
    +matchedWith: int
  }

  class Loan {
    +id: int
    +lenderId: int
    +borrowerId: int
    +offerId: int
    +amount: decimal
    +apy: decimal
    +rateType: LoanRateType
    +baseApy: decimal
    +rateAdjustmentPeriod: int
    +nextRateAdjustmentDate: datetime
    +duration: int
    +ltv: decimal
    +remainingBalance: decimal
    +status: LoanStatus
    +startDate: datetime
    +endDate: datetime
  }

  class Ticket {
    +id: int
    +userId: int
    +ticketNumber: string
    +subject: string
    +description: string
    +priority: TicketPriority
    +status: TicketStatus
    +response: string
    +resolvedAt: datetime
  }

  ' Asociaciones Sequelize reales (src/models/index.js)
  User "1" --> "0..1" Wallet : hasOne (userId)
  User "1" --> "0..*" Offer : hasMany (userId)
  User "1" --> "0..*" Loan  : as 'LentLoans' (lenderId)
  User "1" --> "0..*" Loan  : as 'BorrowedLoans' (borrowerId)
  Loan "0..*" --> "1" User  : as 'Lender' (lenderId)
  Loan "0..*" --> "1" User  : as 'Borrower' (borrowerId)
  Loan "0..*" --> "1" Offer : belongsTo (offerId)
  User "1" --> "0..*" Ticket : hasMany (userId)
}

' ─────────────────────────────────────────
'  PAQUETE: Capa de Controladores (src/controllers)
' ─────────────────────────────────────────
package "Controladores (src/controllers)" {

  class authController {
    +connectWallet(walletConnector): handler
    +register(req,res)
    +login(req,res)
    +getProfile(req,res)
  }

  class loanController {
    +calculateLTV(collateralService): handler
    +requestLoan(collateralService): handler
    +getUserLoans(req,res)
    +matchLoan(loanFactory): handler
    +payLoan(paymentProcessor): handler
    +simulate(oracle): handler
  }

  class marketplaceController {
    +getOffers(priceOracle): handler
    +createOffer(priceOracle): handler
    +cancelOffer(req,res)
    +getCacheStats(req,res)
    +getPrices(priceOracle): handler
  }

  class supportController {
    +createTicket(req,res)
    +getUserTickets(req,res)
    +getTicketById(req,res)
  }
}

' ─────────────────────────────────────────
'  PATRÓN: Singleton — conexión de BD (src/config/database.js)
' ─────────────────────────────────────────
package "Infraestructura — Singleton" {
  class DatabaseConnection <<Singleton>> {
    -{static} instance: DatabaseConnection
    +sequelize: Sequelize
    +testConnection(): Promise
  }
  note right of DatabaseConnection
    Singleton: el constructor devuelve
    instance si ya existe; Object.freeze.
    Exporta sequelize compartida.
  end note
}

' ─────────────────────────────────────────
'  PATRÓN: Adapter + Decorator (TTL) + DIP — Oráculo de precios
'  (src/interfaces, src/services)
' ─────────────────────────────────────────
package "Oráculo de Precios (Adapter + Decorator + DIP)" {

  interface IPriceOracle <<interface>> {
    +getPrice(symbol): Promise<number>
    +getPrices(symbols): Promise<Object>
    +isSymbolSupported(symbol): Promise<boolean>
  }

  class SimulatedOracleAdapter <<Adapter>> {
    -prices: Object
    -volatility: number
    +getPrice(symbol)
    +getPrices(symbols)
    +isSymbolSupported(symbol)
    +setPrice(symbol, price)
    +getSupportedSymbols(): string[]
    +setVolatility(v)
  }

  class CachedPriceOracle <<Decorator>> {
    -oracle: IPriceOracle
    -ttlMs: number
    -cache: Map
    -stats: Object
    +getPrice(symbol)
    +getPrices(symbols)
    +isSymbolSupported(symbol)
    +invalidate(symbol)
    +clear()
    +getStats(): Object
  }

  class priceOracle <<Singleton>> {
    ' Módulo: instancia única
    ' new CachedPriceOracle(new SimulatedOracleAdapter())
  }

  IPriceOracle <|.. SimulatedOracleAdapter
  IPriceOracle <|.. CachedPriceOracle
  CachedPriceOracle o--> "1" IPriceOracle : envuelve (oracle)
  priceOracle ..> CachedPriceOracle : instancia
  priceOracle ..> SimulatedOracleAdapter : adapter
}

' ─────────────────────────────────────────
'  PATRÓN: DIP — Servicio de Colateral y LTV
' ─────────────────────────────────────────
package "Colateral y LTV" {

  interface ICollateralService <<interface>> {
    +getPrice(collateralType)
    +calculateValue(collateralType, collateralAmount)
    +isSufficient(loanAmount, collateralType, collateralAmount)
  }

  class CollateralService {
    -oracle: IPriceOracle
    +getPrice(collateralType)
    +calculateValue(collateralType, collateralAmount)
    +isSufficient(loanAmount, collateralType, collateralAmount)
  }

  class LTVCalculatorService {
    +{static} calculateLTV(loanAmount, collateralValue): LTVResult
  }

  ICollateralService <|.. CollateralService
  CollateralService --> "1" IPriceOracle : DIP (oracle inyectado)
}

' ─────────────────────────────────────────
'  PATRÓN: Factory Method — creación de préstamos
' ─────────────────────────────────────────
package "Factory de Préstamos (Factory Method)" {

  interface ILoanFactory <<interface>> {
    +createFromOffer(offer, lenderId, borrowerId)
    +createLoan(config)
  }

  class LoanFactory {
    -factories: Object
    +createFromOffer(offer, lenderId, borrowerId, rateType)
    +createLoan(config)
    +registerFactory(rateType, factory)
    +getSupportedRateTypes(): string[]
  }

  class FixedRateLoanFactory {
    +createFromOffer(offer, lenderId, borrowerId)
    +createLoan(config)
  }

  class VariableRateLoanFactory {
    -rateAdjustmentPeriod: int
    +createFromOffer(offer, lenderId, borrowerId)
    +createLoan(config)
    +adjustRate(loan, newApy)
  }

  ILoanFactory <|.. LoanFactory
  ILoanFactory <|.. FixedRateLoanFactory
  ILoanFactory <|.. VariableRateLoanFactory
  LoanFactory o--> "1" FixedRateLoanFactory : factories['fixed']
  LoanFactory o--> "1" VariableRateLoanFactory : factories['variable']
  FixedRateLoanFactory ..> Loan : crea
  VariableRateLoanFactory ..> Loan : crea
}

' ─────────────────────────────────────────
'  PATRÓN: DIP — Procesador de pagos
' ─────────────────────────────────────────
package "Procesador de Pagos (DIP)" {

  interface IPaymentProcessor <<interface>> {
    +processPayment({loanId, amount, borrowerId, lenderId})
    +recalculateLTV(remainingBalance, collateralAmount, collateralPrice)
  }

  class StandardPaymentProcessor {
    +processPayment({loanId, amount, borrowerId, lenderId})
    +recalculateLTV(remainingBalance, collateralAmount, collateralPrice)
  }

  IPaymentProcessor <|.. StandardPaymentProcessor
  StandardPaymentProcessor ..> Loan : findByPk / update
  StandardPaymentProcessor ..> Wallet : update saldos
}

' ─────────────────────────────────────────
'  PATRÓN: Observer + Strategy — Monitoreo de riesgo
' ─────────────────────────────────────────
package "Monitoreo de Riesgo (Observer + Strategy)" {

  interface IRiskStrategy <<interface>> {
    +evaluate(loanAmount, collateralValue)
  }

  class LTVRiskStrategy <<Strategy>> {
    -thresholds: Object
    +evaluate(loanAmount, collateralValue)
  }

  interface IRiskObserver <<interface>> {
    +onRiskEvent(event)
  }

  class LogObserver <<Observer>> {
    -logger
    -eventLog: array
    +onRiskEvent(event)
    +getEventHistory(limit)
    +getStatistics()
    +getRecentAlerts(limit)
  }

  class NotificationObserver <<Observer>> {
    -notificationService
    -sentNotifications: array
    +onRiskEvent(event)
    +getNotificationHistory(limit)
  }

  class MonitorRiesgo <<Subject>> {
    -riskStrategy: IRiskStrategy
    -observers: IRiskObserver[]
    -activeMonitorings: Map
    +subscribe(observer)
    +unsubscribe(observer)
    +evaluateLoanRisk(loan, currentCollateralPrice)
    +startMonitoring(loan, priceOracle, intervalMs)
    +stopMonitoring(monitoringId)
  }

  class RiskMonitoringService {
    -monitor: MonitorRiesgo
    -notificationObserver: NotificationObserver
    -logObserver: LogObserver
    +evaluateLoanRisk(loan, collateralPrice)
    +startMonitoring(loan, priceOracle, intervalMs)
    +getRiskReport(loanId)
  }

  IRiskStrategy <|.. LTVRiskStrategy
  IRiskObserver <|.. LogObserver
  IRiskObserver <|.. NotificationObserver
  MonitorRiesgo o--> "0..*" IRiskObserver : observers
  MonitorRiesgo --> "1" IRiskStrategy : strategy (inyectada)
  MonitorRiesgo ..> IPriceOracle : startMonitoring (precio)
  RiskMonitoringService o--> "1" MonitorRiesgo
  RiskMonitoringService o--> "1" LogObserver
  RiskMonitoringService o--> "1" NotificationObserver
}

' ─────────────────────────────────────────
'  PATRÓN: DIP — Conector de Wallet Web3
' ─────────────────────────────────────────
package "Conector Web3 (DIP)" {

  interface IWalletConnector <<interface>> {
    +connect(walletAddress)
    +isValidWallet(walletAddress)
    +hasDuplicateSession(walletAddress)
  }

  class MockWalletConnectorImpl <<Adapter/Mock>> {
    -activeSessions: Map
    +connect(walletAddress)
    +isValidWallet(walletAddress)
    +hasDuplicateSession(walletAddress)
    +disconnect(walletAddress)
  }

  class AuthService {
    +issueToken(userId)
    +register({name, email, password})
    +login({email, password})
  }

  IWalletConnector <|.. MockWalletConnectorImpl
}

' ─────────────────────────────────────────
'  DEPENDENCIAS Controlador -> Servicios (uso real en el código)
' ─────────────────────────────────────────
authController --> IWalletConnector : DIP (connectWallet)
authController ..> AuthService : issueToken/register/login
authController ..> User
authController ..> Wallet

loanController --> ICollateralService : requestLoan/calculateLTV
loanController --> ILoanFactory : matchLoan
loanController --> IPaymentProcessor : payLoan
loanController ..> LTVCalculatorService
loanController ..> priceOracle : simulate
loanController ..> Offer
loanController ..> Loan

marketplaceController --> IPriceOracle : DIP (precios/enriquecimiento)
marketplaceController ..> Offer

supportController ..> Ticket

@enduml
