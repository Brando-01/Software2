@startuml DeFi360 - Diagrama de Clases
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam packageFontSize 13
skinparam linetype ortho
skinparam class {
  BackgroundColor #F8FAFB
  BorderColor #2C3E50
  HeaderBackgroundColor #2C3E50
  HeaderFontColor #FFFFFF
  ArrowColor #2C3E50
}
skinparam package {
  BackgroundColor #EAF2FF
  BorderColor #2980B9
  FontColor #1A252F
}

title DeFi360 — Diagrama de Clases Completo

' ─────────────────────────────────────────
'  ENUMERACIONES
' ─────────────────────────────────────────
enum TipoUsuario {
  INVERSIONISTA
  PRESTATARIO
  ADMINISTRADOR
}

enum EstadoOferta {
  PUBLICADA
  EMPAREJADA
  CANCELADA
  EXPIRADA
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
  CANCELADA
}

enum EstadoPrestamo {
  ACTIVO
  EN_MORA
  LIQUIDADO
  COMPLETADO
}

enum EstadoAlerta {
  PENDIENTE
  ATENDIDA
  IGNORADA
}

enum TipoAlerta {
  RIESGO_MODERADO
  RIESGO_ALTO
  LIQUIDACION_INMINENTE
  LIQUIDACION_EJECUTADA
}

enum TipoActivo {
  CRIPTOMONEDA
  STABLECOIN
  TOKEN
}

enum EstadoTicket {
  ABIERTO
  EN_PROCESO
  CERRADO
}

' ─────────────────────────────────────────
'  PAQUETE: Usuarios y Seguridad
' ─────────────────────────────────────────
package "Usuarios y Seguridad" {

  abstract class Usuario {
    -idUsuario: int
    -nombre: string
    -email: string
    -tipo: TipoUsuario
    -walletAddress: string
    -fechaRegistro: datetime
    -activo: boolean
    +autenticar(walletAddress: string): boolean
    +cerrarSesion(): void
    +obtenerPerfil(): PerfilUsuario
    +actualizarDatos(nombre: string, email: string): void
  }

  class Inversionista {
    -totalInvertido: decimal
    -rendimientoAcumulado: decimal
    +publicarOfertaLending(oferta: OfertaLending): boolean
    +verRendimientos(): List<OfertaLending>
    +retirarFondos(idOferta: int): decimal
  }

  class Prestatario {
    -totalDeudaActiva: decimal
    -historialCrediticio: int
    +solicitarPrestamo(solicitud: SolicitudPrestamo): boolean
    +pagarCuota(idPrestamo: int, monto: decimal): boolean
    +verPrestamosActivos(): List<Prestamo>
  }

  class Administrador {
    -nivelAcceso: int
    +gestionarTicket(idTicket: int, accion: string): void
    +gestionarContenidoEducativo(): void
    +verLogsDelSistema(): List<LogEvento>
    +suspenderUsuario(idUsuario: int): void
    +ejecutarLiquidacion(idPrestamo: int): boolean
  }

  class LogEvento {
    -idLog: int
    -tipo: string
    -descripcion: string
    -fecha: datetime
    -ipOrigen: string
    +registrar(): void
  }

  class TicketSoporte {
    -idTicket: int
    -asunto: string
    -descripcion: string
    -estado: EstadoTicket
    -prioridad: int
    -fechaCreacion: datetime
    -fechaCierre: datetime
    +abrir(): void
    +cerrar(resolucion: string): void
    +escalar(): void
  }

  Usuario <|-- Inversionista
  Usuario <|-- Prestatario
  Usuario <|-- Administrador
  Usuario "1" --> "0..*" TicketSoporte : registra
  Administrador "1" --> "0..*" TicketSoporte : atiende
  Administrador "1" --> "0..*" LogEvento : genera
}

' ─────────────────────────────────────────
'  PAQUETE: Wallet y Activos
' ─────────────────────────────────────────
package "Wallet y Activos" {

  class Wallet {
    -idWallet: int
    -walletAddress: string
    -saldoTotal: decimal
    -saldoDisponible: decimal
    -saldoBloqueado: decimal
    -fechaCreacion: datetime
    +actualizarSaldo(): void
    +bloquearFondos(monto: decimal): boolean
    +liberarFondos(monto: decimal): boolean
    +obtenerHistorial(): List<Transaccion>
  }

  class Activo {
    -idActivo: int
    -simbolo: string
    -nombre: string
    -tipo: TipoActivo
    -decimales: int
    -activo: boolean
    +obtenerPrecioActual(): decimal
  }

  class PosicionWallet {
    -idPosicion: int
    -cantidad: decimal
    -cantidadBloqueada: decimal
    -bloqueadoComoColateral: boolean
    -ultimaActualizacion: datetime
    +getValorEnUSD(): decimal
    +bloquear(cantidad: decimal): boolean
    +liberar(cantidad: decimal): boolean
  }

  class Transaccion {
    -idTransaccion: int
    -tipo: string
    -monto: decimal
    -activoId: int
    -fecha: datetime
    -referencia: string
    +registrar(): void
  }

  Usuario "1" o-- "1" Wallet : posee
  Wallet "1" *-- "0..*" PosicionWallet : contiene
  Wallet "1" --> "0..*" Transaccion : registra
  PosicionWallet "0..*" --> "1" Activo : referencia
}

' ─────────────────────────────────────────
'  PAQUETE: Lending / Borrowing
' ─────────────────────────────────────────
package "Lending / Borrowing" {

  class OfertaLending {
    -idOferta: int
    -monto: decimal
    -tasaInteresAnual: decimal
    -plazoDias: int
    -montoMinimoPrestamo: decimal
    -activoId: int
    -estado: EstadoOferta
    -fechaPublicacion: datetime
    -fechaExpiracion: datetime
    +publicar(): boolean
    +cancelar(): boolean
    +calcularRendimientoEsperado(): decimal
    +estaDisponible(): boolean
  }

  class SolicitudPrestamo {
    -idSolicitud: int
    -montoSolicitado: decimal
    -montoColateral: decimal
    -ltvObjetivo: decimal
    -activoColateralId: int
    -plazoSolicitadoDias: int
    -estado: EstadoSolicitud
    -fechaCreacion: datetime
    +registrar(): boolean
    +cancelar(): boolean
    +calcularLTV(): decimal
    +validarColateral(): boolean
  }

  class Prestamo {
    -idPrestamo: int
    -monto: decimal
    -tasaInteres: decimal
    -ltvInicial: decimal
    -ltvActual: decimal
    -saldoPendiente: decimal
    -cuotaMensual: decimal
    -estado: EstadoPrestamo
    -fechaInicio: datetime
    -fechaVencimiento: datetime
    +pagarCuota(monto: decimal): boolean
    +calcularLTVActual(): decimal
    +estaEnRiesgo(): boolean
    +liquidarColateral(): boolean
    +calcularMoraAcumulada(): decimal
    +obtenerEstadoCuenta(): ResumenPrestamo
  }

  class Colateral {
    -idColateral: int
    -montoBloqueado: decimal
    -valorActualUSD: decimal
    -ltvActual: decimal
    -umbralAlerta: decimal
    -umbralLiquidacion: decimal
    -fechaBloqueo: datetime
    +actualizarValor(precioActual: decimal): void
    +calcularLTV(saldoPrestamo: decimal): decimal
    +requiereAlerta(): boolean
    +requiereLiquidacion(): boolean
  }

  class MotorEmparejamiento {
    +buscarOfertaCompatible(solicitud: SolicitudPrestamo): OfertaLending
    +emparejar(oferta: OfertaLending, solicitud: SolicitudPrestamo): Prestamo
    +calcularTasaOptima(): decimal
  }

  Inversionista "1" --> "0..*" OfertaLending : publica
  Prestatario "1" --> "0..*" SolicitudPrestamo : crea
  OfertaLending "0..1" --> "0..*" Prestamo : origina
  SolicitudPrestamo "0..1" --> "0..1" Prestamo : seConvierteEn
  Prestamo "1" *-- "1..*" Colateral : garantiza
  Colateral "1" --> "1" Activo : usa
  MotorEmparejamiento ..> OfertaLending : consulta
  MotorEmparejamiento ..> SolicitudPrestamo : consulta
  MotorEmparejamiento ..> Prestamo : crea
}

' ─────────────────────────────────────────
'  PAQUETE: Riesgo y Oráculo
' ─────────────────────────────────────────
package "Riesgo y Oráculo" {

  class OraculoPrecios {
    -urlFuente: string
    -frecuenciaActualizacion: int
    -ultimaActualizacion: datetime
    +obtenerPrecio(activo: Activo): decimal
    +obtenerHistorialPrecios(activo: Activo, dias: int): List<decimal>
    +estaActualizado(): boolean
  }

  class RegistroPrecio {
    -idRegistro: int
    -activoId: int
    -precio: decimal
    -fuente: string
    -fecha: datetime
  }

  class MonitorRiesgo {
    -intervaloMonitoreoSeg: int
    +ejecutarCiclo(): void
    +evaluarPrestamo(prestamo: Prestamo): void
    +calcularLTVGlobal(): List<decimal>
    +identificarEnRiesgo(): List<Prestamo>
  }

  class AlertaRiesgo {
    -idAlerta: int
    -tipo: TipoAlerta
    -mensaje: string
    -ltvAlMomentoAlerta: decimal
    -fecha: datetime
    -estado: EstadoAlerta
    +enviarNotificacion(): void
    +marcarAtendida(): void
  }

  OraculoPrecios "1" --> "0..*" RegistroPrecio : genera
  OraculoPrecios --> Activo : consultaPrecio
  MonitorRiesgo --> OraculoPrecios : usa
  MonitorRiesgo --> Prestamo : evalua
  MonitorRiesgo "1" --> "0..*" AlertaRiesgo : genera
  Prestamo "1" --> "0..*" AlertaRiesgo : recibe
  Usuario "1" --> "0..*" AlertaRiesgo : notificado
}

' ─────────────────────────────────────────
'  PAQUETE: Zona Educativa
' ─────────────────────────────────────────
package "Zona Educativa" {

  class RecursoEducativo {
    -idRecurso: int
    -titulo: string
    -tipoRecurso: string
    -contenido: string
    -urlContenido: string
    -nivel: string
    -etiquetas: List<string>
    -vecesVisto: int
    +incrementarVistas(): void
    +obtenerContenido(): string
  }

  class TerminoGlosario {
    -idTermino: int
    -termino: string
    -definicion: string
    -ejemplos: string
    -relacionados: List<string>
    +buscar(query: string): List<TerminoGlosario>
  }

  class SimulacionDeFi {
    -idSimulacion: int
    -tipo: string
    -montoInicial: decimal
    -tasaAnual: decimal
    -plazoDias: int
    -activoId: int
    -rendimientoEstimado: decimal
    -ltvSimulado: decimal
    -resultadoDetallado: string
    -fecha: datetime
    +calcularRendimiento(): decimal
    +calcularLTV(): decimal
    +generarProyeccion(): List<decimal>
    +guardarResultado(): void
  }

  class ActividadEducativa {
    -idActividad: int
    -usuarioId: int
    -recursoId: int
    -tipoActividad: string
    -fecha: datetime
    +registrar(): void
  }

  Usuario "1" --> "0..*" SimulacionDeFi : ejecuta
  Usuario "1" --> "0..*" ActividadEducativa : genera
  RecursoEducativo "1" --> "0..*" ActividadEducativa : registra
  Administrador "1" --> "0..*" RecursoEducativo : administra
  SimulacionDeFi --> OraculoPrecios : consulta
}

@enduml
