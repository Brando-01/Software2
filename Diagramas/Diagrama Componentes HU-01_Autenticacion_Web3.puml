@startuml HU-01_Autenticacion_Web3
title HU-01 — Autenticación Web3 (Componentes)\nDeFi360 · Sprint 1 · Release 01

skinparam componentStyle rectangle
skinparam backgroundColor #FAFAFA
skinparam component {
  BackgroundColor #E8F4FD
  BorderColor #2980B9
  FontColor #1A252F
  FontSize 12
}
skinparam interface {
  BackgroundColor #FDEBD0
  BorderColor #E67E22
}
skinparam database {
  BackgroundColor #D5F5E3
  BorderColor #1E8449
}
skinparam node {
  BackgroundColor #F2F3F4
  BorderColor #717D7E
}
skinparam arrow {
  Color #2C3E50
  FontSize 10
}

' ─── FRONTEND ───────────────────────────────────────────────────
node "Frontend (React SPA)" {
  [main.jsx (login / connect-wallet)] as LoginUI
}

' ─── CONTROLADOR ────────────────────────────────────────────────
node "Backend — Controllers" {
  [authController] as AuthCtrl
}

' ─── MIDDLEWARE ─────────────────────────────────────────────────
node "Backend — Middleware" {
  [authMiddleware (protect, JWT)] as Mw
}

' ─── ABSTRACCIÓN DIP ────────────────────────────────────────────
interface "IWalletConnector" as IWallet

' ─── SERVICES / ADAPTERS ────────────────────────────────────────
node "Backend — Services / Adapters" {
  [MockWalletConnectorImpl] as MockWallet
  [AuthService (JWT + bcrypt)] as AuthSvc
}

' ─── SINGLETON DE BASE DE DATOS ─────────────────────────────────
node "Backend — Infrastructure" {
  [DatabaseConnection «Singleton»] as DBConn
}

database "PostgreSQL (DeFi360)" as PG {
  [tabla: users] as TblUsers
  [tabla: wallets] as TblWallets
}

' ─── PRUEBAS ────────────────────────────────────────────────────
node "Tests (Jest)" {
  [authController.test.js] as AuthTest
}

' ─── RELACIONES ─────────────────────────────────────────────────
LoginUI   --> AuthCtrl    : POST /api/auth/connect-wallet\nPOST /register · /login
AuthCtrl  ..> IWallet     : «depends on»\n(inyección por parámetro)
MockWallet ..|> IWallet   : «implements»
AuthCtrl  ..> AuthSvc     : issueToken / register / login
AuthCtrl  --> DBConn      : User / Wallet (Sequelize)
Mw        ..> AuthSvc     : verifica JWT (GET /profile)
DBConn    --> PG          : Sequelize (instancia única)
DBConn    ..> TblUsers    : INSERT / SELECT
DBConn    ..> TblWallets  : INSERT / SELECT
AuthTest  ..> IWallet     : mock connector
AuthTest  --> AuthCtrl    : prueba unitaria

note bottom of MockWallet
  Decisión de alcance: conexión de wallet SIMULADA
  (valida formato 0x...). El conector real Web3/MetaMask
  queda como extensión futura sobre la misma interfaz.
end note

@enduml
